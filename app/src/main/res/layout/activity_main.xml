<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridLayout2"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_margin="10dp"
        android:padding="2dp"
        app:columnCount="5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rowCount="4">

        <!-- ===== Строка 1: 5 равных ячеек ===== -->

        <EditText
            android:id="@+id/editTextFirst"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:inputType="numberDecimal"
            android:minWidth="0dp"
            android:text=""
            android:textSize="24sp"
            android:textStyle="normal"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_row="0"
            app:layout_rowWeight="1" />

        <TextView
            android:id="@+id/textOp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:text="+"
            android:textSize="28sp"
            android:textStyle="normal"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_row="0"
            app:layout_rowWeight="1" />

        <EditText
            android:id="@+id/editTextSecond"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:inputType="numberDecimal"
            android:minWidth="0dp"
            android:text=""
            android:textSize="24sp"
            android:textStyle="normal"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_row="0"
            app:layout_rowWeight="1" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:text="="
            android:textSize="28sp"
            android:textStyle="normal"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_row="0"
            app:layout_rowWeight="1" />

        <TextView
            android:id="@+id/textResult"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:text=""
            android:textSize="24sp"
            android:textStyle="normal"
            app:layout_column="4"
            app:layout_columnWeight="1"
            app:layout_row="0"
            app:layout_rowWeight="1" />

        <!-- ===== Строки 2–3: кнопки ===== -->

        <!-- Кнопка слева, 2 строки -->
        <Button
            android:id="@+id/buttonSum"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:backgroundTint="#93A1D5"
            android:text="+"
            android:textColor="#000000"
            android:textSize="32sp"
            app:cornerRadius="0dp"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_row="1"
            app:layout_rowSpan="2"
            app:layout_rowWeight="2" />

        <!-- Кнопка на 2 колонки -->
        <Button
            android:id="@+id/buttonDif"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:backgroundTint="#93A1D5"
            android:text="-"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold"
            app:cornerRadius="0dp"
            app:layout_column="1"
            app:layout_columnSpan="2"
            app:layout_columnWeight="2"
            app:layout_row="1"
            app:layout_rowWeight="1" />

        <!-- Кнопка на 2 колонки -->
        <Button
            android:id="@+id/buttonDiv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:backgroundTint="#93A1D5"
            android:text="/"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold"
            app:cornerRadius="0dp"
            app:layout_column="3"
            app:layout_columnSpan="2"
            app:layout_columnWeight="2"
            app:layout_row="1"
            app:layout_rowWeight="1" />

        <!-- Кнопка снизу, 4 колонки -->
        <Button
            android:id="@+id/buttonMult"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:backgroundTint="#93A1D5"
            android:text="*"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold"
            app:cornerRadius="0dp"
            app:layout_column="1"
            app:layout_columnSpan="4"
            app:layout_columnWeight="4"
            app:layout_row="2"
            app:layout_rowWeight="1" />

        <!-- ===== Строка 4: кнопка на всю ширину ===== -->

        <Button
            android:id="@+id/buttonClear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:backgroundTint="#93A1D5"
            android:text="C"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            app:cornerRadius="0dp"
            app:layout_column="0"
            app:layout_columnSpan="5"
            app:layout_columnWeight="5"
            app:layout_row="3"
            app:layout_rowWeight="1" />

    </androidx.gridlayout.widget.GridLayout>

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Хадиулин Дамир Т-433901-ИСТ"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gridLayout2" />

</androidx.constraintlayout.widget.ConstraintLayout>